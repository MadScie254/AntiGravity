# Backend Configuration
# ===================

# Django Secret Key - CHANGE IN PRODUCTION!
DJANGO_SECRET_KEY=change-me-in-production-use-strong-random-string

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated, e.g., localhost,example.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For local dev with SQLite, leave DATABASE_URL commented
# For production with PostgreSQL, uncomment and configure:
# DATABASE_URL=postgresql://username:password@host:port/database
# DATABASE_URL=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Token Settings
JWT_SECRET=change-me-in-production-jwt-secret-key
JWT_ACCESS_LIFETIME=300
JWT_REFRESH_LIFETIME=2592000

# Email Configuration
# For development, emails will be logged to console
# For production, configure with SendGrid/Mailgun:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@antigravity.app

# OAuth Configuration
# Get these from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS Settings
# Frontend URL for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend Configuration
# ===================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth (same as backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=

# Production Settings
# ===================
# When deploying to production:
# 1. Set DEBUG=False
# 2. Change DJANGO_SECRET_KEY to a strong random string
# 3. Configure DATABASE_URL with PostgreSQL
# 4. Set ALLOWED_HOSTS to your domain
# 5. Configure real email backend credentials
# 6. Set up Google OAuth with production callback URLs
# 7. Update CORS_ALLOWED_ORIGINS with production frontend URL
